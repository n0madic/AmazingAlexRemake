<?xml version="1.0" encoding="utf-8"?>
<!-- The remake's Android package (docs/10 §6): a NativeActivity around libamazing_alex.so (raylib's
     android_main → our main). The original (com.rovio.amazingalex, minSdk 7, targetSdk 13) locked
     `landscape`; sensorLandscape is the modern equivalent that allows both landscape directions.
     targetSdk stays at 34: Android 16 ignores screenOrientation for apps targeting 36 on ≥ 600 dp
     screens (docs/10 §11 item 15). exported="true" is required of a launcher activity since API 31;
     tools/build_android.sh enables debuggable only for Debug builds. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.amazingalex.remake"
    android:versionCode="1"
    android:versionName="1.0.5">
    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34" />
    <uses-feature android:glEsVersion="0x00020000" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="true" />
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:hasCode="false"
        android:debuggable="false"
        android:extractNativeLibs="true"
        android:allowBackup="false"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">
        <activity
            android:name="android.app.NativeActivity"
            android:label="@string/app_name"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|keyboardHidden|screenSize|smallestScreenSize|screenLayout|density|uiMode">
            <meta-data android:name="android.app.lib_name" android:value="amazing_alex" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
